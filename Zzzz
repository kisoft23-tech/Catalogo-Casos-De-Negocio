function pintarStats(){
  const z=document.getElementById("stats"); z.textContent="";
  const vacio=r=>!r.k.length&&!r.p.length&&!r.g.length&&!(mias[r.id]||[]).length;
  let datos;
  if(vista==="casos"){
    datos=[
     ["total","Casos en el catálogo",CASOS.length,null,false],
     ["frec","Marcados como frecuentes",favs.size,()=>{fFav=!fFav;render();},fFav],
     ["falta","Sin descripción",CASOS.filter(vacio).length,()=>{fFalta=!fFalta;render();},fFalta],
     ["adm","Veces que has copiado",Object.values(usos).reduce((a,b)=>a+b,0),null,false]];
  } else if(vista==="rapidas"){
    const g=[...new Set(RAPIDAS.map(x=>x.g))];
    datos=[["total","Scripts disponibles",RAPIDAS.length,null,false],
           ["frec","Grupos",g.length,null,false],
           ["falta","Con datos por llenar",RAPIDAS.filter(x=>/xxx/i.test(x.x)).length,null,false]];
  } else if(vista==="notas"){
    datos=[["total","Notas guardadas",notas.length,null,false],
           ["frec","Fijadas arriba",notas.filter(n=>n.f).length,null,false],
           ["adm","Palabras escritas",notas.reduce((a,n)=>a+((n.t+" "+n.c).trim().split(/\s+/).filter(Boolean).length),0),null,false]];
  } else {
    const cli=AYUDA.filter(x=>/cliente/i.test(x.q)).length;
    datos=[["total","Artículos en total",AYUDA.length,null,false],
           ["frec","Para el asesor",AYUDA.length-cli,()=>{fAyuda=fAyuda==="asesor"?null:"asesor";render();},fAyuda==="asesor"],
           ["adm","Para el cliente",cli,()=>{fAyuda=fAyuda==="cliente"?null:"cliente";render();},fAyuda==="cliente"]];
  }
  datos.forEach(([k,et,val,fn,act])=>{
    const b=document.createElement(fn?"button":"div");
    b.className="stat"; b.dataset.k=k;
    if(fn){b.onclick=fn; b.setAttribute("aria-pressed",act?"true":"false");}
    const v=document.createElement("span");v.className="v";v.textContent=val;
    const e=document.createElement("span");e.className="e";e.textContent=et;
    b.append(v,e); z.append(b);
  });
}
const dlg=document.getElementById("dlg");
function abrirRespaldo(){
  document.getElementById("dlgTxt").value=JSON.stringify(
    {v:1, notas:notas, favoritos:[...favs], palabras:mias}, null, 1);
  dlg.showModal();
}
document.getElementById("exportar").onclick=abrirRespaldo;
document.getElementById("respaldo").onclick=abrirRespaldo;
document.getElementById("dlgCopiar").onclick=async()=>{
  await copiarTxt(document.getElementById("dlgTxt").value);aviso("Respaldo copiado");};
document.getElementById("dlgRest").onclick=()=>{
  let d;
  try{ d=JSON.parse(document.getElementById("dlgTxt").value); }
  catch(e){ aviso("Ese texto no es un respaldo válido"); return; }
  if(!d||typeof d!=="object"){aviso("Ese texto no es un respaldo válido");return;}
  if(Array.isArray(d.notas)){
    const hay=new Set(notas.map(n=>n.id));
    d.notas.forEach(n=>{ if(n&&n.id&&!hay.has(n.id)) notas.push(n); });
    notas.sort((a,b)=>b.ts-a.ts);
  }
  if(Array.isArray(d.favoritos)) d.favoritos.forEach(x=>favs.add(x));
  if(d.palabras&&typeof d.palabras==="object") Object.assign(mias,d.palabras);
  CASOS.forEach(indexar); grabar(); dlg.close(); render();
  aviso("Respaldo restaurado");
};
if(vistaGuardada && ["casos","rapidas","ayuda","notas"].includes(vistaGuardada)) vista=vistaGuardada;
render();
if(matchMedia("(min-width: 1000px)").matches && vista!=="notas") q.focus();
