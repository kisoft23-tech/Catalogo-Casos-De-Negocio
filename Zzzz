<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Casos de negocio · Social Media</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ════════ tokens ════════ */
:root{
  color-scheme:light;
  --aqua:#00A99D; --rosa:#E6007E; --naranja:#F07E26; --oro:#FFC800;
  --penta:#E0183A; --pentaOsc:#A81830;
  --lado:#12151A; --ladoTxt:#9AA4AE; --ladoLinea:#242A32;
  --papel:#F6F6F3; --papel2:#EDEEE9;
  --sup:#FFFFFF; --sup2:#F4F5F1; --vidrio:rgba(255,255,255,.82);
  --tinta:#10151A; --tinta2:#525D67; --tinta3:#8A939C;
  --linea:#E6E8E2; --linea2:#D3D6CF;
  --cc:#00857C; --ccSuave:rgba(0,133,124,.1);
  --s1:0 1px 2px rgba(16,21,26,.04);
  --s2:0 2px 4px rgba(16,21,26,.05),0 8px 24px rgba(16,21,26,.06);
  --s3:0 4px 10px rgba(16,21,26,.07),0 16px 40px rgba(16,21,26,.09);
  --r:14px;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){
  color-scheme:dark;
  --papel:#0B0E11; --papel2:#0F1317;
  --sup:#161B20; --sup2:#1D232A; --vidrio:rgba(11,14,17,.82);
  --tinta:#ECEFF1; --tinta2:#A8B2BA; --tinta3:#76818A;
  --linea:#242B32; --linea2:#333C45;
  --cc:#2FC7B8; --ccSuave:rgba(47,199,184,.13);
  --s1:0 1px 2px rgba(0,0,0,.4);
  --s2:0 2px 4px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.3);
  --s3:0 4px 10px rgba(0,0,0,.45),0 16px 40px rgba(0,0,0,.4);
}}
:root[data-theme="dark"]{
  color-scheme:dark;
  --papel:#0B0E11; --papel2:#0F1317;
  --sup:#161B20; --sup2:#1D232A; --vidrio:rgba(11,14,17,.82);
  --tinta:#ECEFF1; --tinta2:#A8B2BA; --tinta3:#76818A;
  --linea:#242B32; --linea2:#333C45;
  --cc:#2FC7B8; --ccSuave:rgba(47,199,184,.13);
  --s1:0 1px 2px rgba(0,0,0,.4);
  --s2:0 2px 4px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.3);
  --s3:0 4px 10px rgba(0,0,0,.45),0 16px 40px rgba(0,0,0,.4);
}
[n="d"]{--nBg:var(--sup);--nLin:var(--linea)}
[n="r"]{--nBg:#FDE8EC;--nLin:#F5CBD4}
[n="n"]{--nBg:#FDECDC;--nLin:#F6D5B6}
[n="a"]{--nBg:#FFF6D6;--nLin:#F2E3A8}
[n="v"]{--nBg:#DFF4E8;--nLin:#B9E3CE}
[n="t"]{--nBg:#D9F2F0;--nLin:#AEE0DC}
[n="z"]{--nBg:#E2ECFB;--nLin:#C0D5F0}
[n="m"]{--nBg:#FBE3F0;--nLin:#F2C2DD}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){
 & [n="d"]{--nBg:var(--sup);--nLin:var(--linea)}}}
[data-cat="SERVICIOS"]{--cc:#00857C;--ccSuave:rgba(0,133,124,.11)}
[data-cat="TELEVISION"]{--cc:#C4006A;--ccSuave:rgba(196,0,106,.10)}
[data-cat="SOPORTE GENERAL"]{--cc:#C25E0B;--ccSuave:rgba(194,94,11,.11)}
@media(prefers-color-scheme:dark){
 :root:not([data-theme="light"]) [data-cat="SERVICIOS"]{--cc:#34CFBF;--ccSuave:rgba(52,207,191,.14)}
 :root:not([data-theme="light"]) [data-cat="TELEVISION"]{--cc:#FF63AE;--ccSuave:rgba(255,99,174,.14)}
 :root:not([data-theme="light"]) [data-cat="SOPORTE GENERAL"]{--cc:#F8A34A;--ccSuave:rgba(248,163,74,.14)}
}
[data-theme="dark"] [n="r"],[data-theme="dark"] [n="n"],[data-theme="dark"] [n="a"],
[data-theme="dark"] [n="v"],[data-theme="dark"] [n="t"],[data-theme="dark"] [n="z"],
[data-theme="dark"] [n="m"]{--nLin:transparent}
[data-theme="dark"] [n="r"]{--nBg:#3A1A22}
[data-theme="dark"] [n="n"]{--nBg:#3A2618}
[data-theme="dark"] [n="a"]{--nBg:#3A3318}
[data-theme="dark"] [n="v"]{--nBg:#17331F}
[data-theme="dark"] [n="t"]{--nBg:#13322F}
[data-theme="dark"] [n="z"]{--nBg:#1A2A3F}
[data-theme="dark"] [n="m"]{--nBg:#38182C}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) [n="r"]{--nBg:#3A1A22;--nLin:transparent}
 :root:not([data-theme="light"]) [n="n"]{--nBg:#3A2618;--nLin:transparent}
 :root:not([data-theme="light"]) [n="a"]{--nBg:#3A3318;--nLin:transparent}
 :root:not([data-theme="light"]) [n="v"]{--nBg:#17331F;--nLin:transparent}
 :root:not([data-theme="light"]) [n="t"]{--nBg:#13322F;--nLin:transparent}
 :root:not([data-theme="light"]) [n="z"]{--nBg:#1A2A3F;--nLin:transparent}
 :root:not([data-theme="light"]) [n="m"]{--nBg:#38182C;--nLin:transparent}}
:root[data-theme="dark"] [data-cat="SERVICIOS"]{--cc:#34CFBF;--ccSuave:rgba(52,207,191,.14)}
:root[data-theme="dark"] [data-cat="TELEVISION"]{--cc:#FF63AE;--ccSuave:rgba(255,99,174,.14)}
:root[data-theme="dark"] [data-cat="SOPORTE GENERAL"]{--cc:#F8A34A;--ccSuave:rgba(248,163,74,.14)}

*,*::before,*::after{box-sizing:inherit}
html{height:100%;scroll-padding-top:150px}
body{
  margin:0;min-height:100%;color:var(--tinta);
  background:
    radial-gradient(900px 420px at 88% -12%, color-mix(in srgb,var(--rosa) 7%,transparent), transparent 70%),
    radial-gradient(760px 380px at 4% -6%, color-mix(in srgb,var(--aqua) 9%,transparent), transparent 70%),
    var(--papel);
  background-attachment:fixed;
  font-family:"Plus Jakarta Sans","Segoe UI",system-ui,-apple-system,sans-serif;
  font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased;
}
.env{max-width:1180px;margin:0 auto;padding:0 26px}
/* ── armazón ── */
.app{display:grid;grid-template-columns:238px 1fr;min-height:100vh}
.lado{background:var(--lado);border-right:1px solid var(--ladoLinea);display:flex;flex-direction:column;
  position:sticky;top:0;height:100vh;padding:calc(18px + env(safe-area-inset-top,0px)) 0 18px}
.lado .top{padding:0 18px 20px;display:flex;align-items:center;gap:11px}
.lado .chip{width:36px;height:36px;border-radius:11px;flex:0 0 auto;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--penta),var(--pentaOsc));box-shadow:0 2px 10px rgba(224,24,58,.35)}
.lado .chip svg{width:19px;height:19px;stroke:#fff;fill:none;stroke-width:2.4;stroke-linecap:round}
.lado .top h1{margin:0;font-size:14.5px;font-weight:700;color:#fff;letter-spacing:-.015em;line-height:1.25}
.lado .top p{margin:2px 0 0;font-size:11px;color:var(--ladoTxt);font-weight:500}
.lado nav{display:flex;flex-direction:column;gap:2px;padding:0 11px}
.lado nav button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;font:inherit;
  font-size:13.5px;font-weight:600;padding:10px 12px;border:0;border-radius:11px;cursor:pointer;
  background:transparent;color:var(--ladoTxt);transition:.16s}
.lado nav button svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}
.lado nav button:hover{background:rgba(255,255,255,.06);color:#E8EDF2}
.lado nav button[aria-selected="true"]{background:rgba(224,24,58,.16);color:#fff;
  box-shadow:inset 2px 0 0 var(--penta)}
.lado nav button:focus-visible{outline:2px solid var(--penta);outline-offset:-2px}
.lado nav .num{margin-left:auto;font-size:11px;font-weight:600;color:var(--ladoTxt);
  background:rgba(255,255,255,.07);padding:2px 7px;border-radius:6px}
.lado .fin{margin-top:auto;padding:16px 18px 0;border-top:1px solid var(--ladoLinea);
  display:flex;align-items:center;justify-content:space-between;gap:10px}
.lado .fin .tiras{display:flex;gap:3px}
.lado .fin .tiras i{width:13px;height:4px;border-radius:2px;display:block}
.lado .fin small{font-size:10.5px;color:var(--ladoTxt);font-weight:600;letter-spacing:.04em}
.principal{min-width:0;display:flex;flex-direction:column}
/* ── notas ── */
.nueva{background:var(--sup);border:1px solid var(--linea2);border-radius:14px;box-shadow:var(--s2);
  margin:4px 0 20px;overflow:hidden;transition:.18s}
.nueva.cerrada{cursor:text}
.nueva .falsa{padding:15px 18px;font-size:15px;color:var(--tinta3);font-weight:500}
.nueva .abierta{padding:14px 16px 12px;display:none}
.nueva.abierta .abierta{display:block}
.nueva.abierta .falsa{display:none}
.nueva input.tt,.nueva textarea{width:100%;border:0;background:transparent;color:var(--tinta);
  font:inherit;outline:none;resize:none}
.nueva input.tt{font-size:15.5px;font-weight:700;letter-spacing:-.01em;margin-bottom:6px}
.nueva textarea{font-size:14.5px;line-height:1.6;min-height:64px}
.nueva .pie2{display:flex;align-items:center;gap:7px;margin-top:8px;flex-wrap:wrap}
.pal{display:flex;gap:5px;flex-wrap:wrap}
.pal button{width:22px;height:22px;border-radius:50%;cursor:pointer;border:1.5px solid rgba(0,0,0,.14);padding:0}
.pal button:focus-visible{outline:2px solid var(--cc);outline-offset:2px}
.pal button[aria-pressed="true"]{box-shadow:0 0 0 2px var(--sup),0 0 0 4px var(--tinta2)}
.rejilla{columns:280px;column-gap:12px;padding-bottom:80px}
.nota{break-inside:avoid;margin:0 0 12px;border-radius:14px;padding:14px 16px;border:1px solid var(--nLin);
  background:var(--nBg);box-shadow:var(--s1);transition:.16s;position:relative}
.nota:hover{box-shadow:var(--s2);transform:translateY(-1px)}
.nota h4{margin:0 0 5px;font-size:15px;font-weight:700;letter-spacing:-.01em;word-break:break-word}
.nota .txt{font-size:14px;line-height:1.62;color:var(--tinta2);white-space:pre-wrap;word-break:break-word}
.nota .meta2{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:11px}
.nota time{font-size:11px;color:var(--tinta3);font-weight:600}
.nota .bb{display:flex;gap:4px;opacity:0;transition:.16s}
.nota:hover .bb,.nota:focus-within .bb{opacity:1}
.nota .bb button{width:27px;height:27px;border-radius:8px;border:1px solid var(--nLin);
  background:transparent;color:var(--tinta2);cursor:pointer;font-size:12px;display:grid;place-items:center;padding:0}
.nota .bb button:hover{background:rgba(0,0,0,.06);color:var(--tinta)}
.nota .bb button:focus-visible{outline:2px solid var(--tinta2);outline-offset:1px;opacity:1}
.nota .fij{position:absolute;top:11px;right:12px;font-size:12px;color:var(--tinta2)}
.nota[contenteditable],.nota .ed{outline:none}
.nota .ed{width:100%;border:0;background:transparent;color:inherit;font:inherit;outline:none;resize:none}
.nota .ed.t{font-size:15px;font-weight:700;margin-bottom:5px}
.nota .ed.c{font-size:14px;line-height:1.62;color:var(--tinta2);min-height:50px}
.tituloFijas{font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--tinta3);
  padding:2px 0 10px;text-transform:uppercase}
.filaNueva{display:flex;gap:10px;align-items:flex-start;margin:4px 0 20px}
.filaNueva .nueva{flex:1;margin:0}
.filaNueva .atajo{flex:0 0 auto;padding-top:9px}
.plantillaCN{height:36px!important;border-color:color-mix(in srgb,var(--aqua) 50%,transparent)!important;
  color:var(--aqua)!important;font-weight:700!important}
.plantillaCN:hover{background:color-mix(in srgb,var(--aqua) 12%,transparent)!important}
@media(max-width:640px){.filaNueva{flex-direction:column}.filaNueva .atajo{padding-top:0;width:100%}
  .plantillaCN{width:100%}}
/* ── métricas ── */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;padding:20px 0 2px}
.stat{text-align:left;font:inherit;background:var(--sup);border:1px solid var(--linea);border-radius:13px;
  padding:13px 15px;cursor:pointer;transition:.16s;box-shadow:var(--s1);position:relative;overflow:hidden}
.stat::after{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--cc);opacity:0;transition:.16s}
.stat:hover{transform:translateY(-2px);box-shadow:var(--s2);border-color:var(--linea2)}
.stat:focus-visible{outline:2px solid var(--cc);outline-offset:2px}
.stat[aria-pressed="true"]{border-color:color-mix(in srgb,var(--cc) 45%,transparent);background:var(--ccSuave)}
.stat[aria-pressed="true"]::after{opacity:1}
.stat .v{display:block;font-size:25px;font-weight:800;letter-spacing:-.03em;line-height:1.1;
  color:var(--tinta);font-variant-numeric:tabular-nums}
.stat .e{display:block;font-size:11.5px;font-weight:600;color:var(--tinta3);margin-top:3px;letter-spacing:.01em}
.stat[data-k="frec"]{--cc:var(--oro)}
.stat[data-k="falta"]{--cc:var(--naranja)}
.stat[data-k="adm"]{--cc:var(--rosa)}
@media(max-width:1000px){
  .app{grid-template-columns:1fr}
  .lado{position:sticky;top:0;height:auto;flex-direction:row;align-items:center;gap:14px;
    border-right:0;border-bottom:1px solid var(--ladoLinea);padding:10px 14px;z-index:45;
    padding-top:calc(10px + env(safe-area-inset-top,0px))}
  .lado .top{padding:0;flex:0 0 auto}
  .lado .top div{display:none}
  .lado nav{flex-direction:row;padding:0;gap:4px;overflow-x:auto;scrollbar-width:none;flex:1}
  .lado nav::-webkit-scrollbar{display:none}
  .lado nav button{width:auto;white-space:nowrap;padding:8px 13px}
  .lado nav .num{display:none}
  .lado .fin{display:none}
}
@media(max-width:640px){.env{padding:0 15px}}

/* ════════ cabecera ════════ */
.franja{position:fixed;inset:0 0 auto;height:3px;z-index:60;
  background:linear-gradient(90deg,var(--aqua) 0 25%,var(--oro) 25% 50%,var(--naranja) 50% 75%,var(--rosa) 75% 100%)}
body::before{content:"";position:fixed;inset:3px 0 auto;height:env(safe-area-inset-top,0px);
  background:var(--lado);z-index:50}
header{position:sticky;top:0;z-index:38;background:var(--vidrio);
  backdrop-filter:blur(14px);border-bottom:1px solid var(--linea)}
@media(max-width:1000px){header{top:60px}}
.titulo{padding:20px 0 14px}
.titulo h2{margin:0;font-size:21px;font-weight:800;letter-spacing:-.03em}
.titulo p{margin:3px 0 0;font-size:13px;color:var(--tinta3);font-weight:500}
.cab{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0 12px}
.marca{display:flex;align-items:center;gap:11px;min-width:0}
.logo{width:34px;height:34px;border-radius:11px;flex:0 0 auto;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--aqua),#0E7F9E 55%,var(--rosa));box-shadow:var(--s1)}
.logo svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2.4;stroke-linecap:round}
.marca h1{margin:0;font-size:16.5px;font-weight:700;letter-spacing:-.02em;line-height:1.2}
.marca p{margin:1px 0 0;font-size:12px;color:var(--tinta3);font-weight:500}
.tema{width:34px;height:34px;flex:0 0 auto;border-radius:11px;border:1px solid var(--linea2);
  background:var(--sup);color:var(--tinta2);cursor:pointer;display:grid;place-items:center;font-size:15px}
.tema:hover{color:var(--tinta);border-color:var(--tinta3)}
.tema:focus-visible{outline:2px solid var(--cc);outline-offset:2px}

nav{display:flex;gap:4px;padding-bottom:12px}
nav button{font:inherit;font-size:13.5px;font-weight:600;padding:7px 15px;border:1px solid transparent;
  background:transparent;color:var(--tinta3);cursor:pointer;border-radius:999px;transition:.16s}
nav button:hover{color:var(--tinta);background:var(--sup2)}
nav button[aria-selected="true"]{color:var(--cc);background:var(--ccSuave);border-color:color-mix(in srgb,var(--cc) 26%,transparent)}
nav button:focus-visible{outline:2px solid var(--cc);outline-offset:1px}

.campo{position:relative;display:flex;align-items:center}
.lupa{position:absolute;left:17px;width:18px;height:18px;stroke:var(--tinta3);fill:none;
  stroke-width:2.1;stroke-linecap:round;pointer-events:none;transition:stroke .16s}
.campo:focus-within .lupa{stroke:var(--cc)}
#q{width:100%;padding:16px 52px 16px 48px;font:inherit;font-size:16.5px;font-weight:500;color:var(--tinta);
  background:var(--sup);border:1.5px solid var(--linea2);border-radius:15px;outline:none;
  box-shadow:var(--s2);transition:border-color .16s,box-shadow .16s}
#q:focus{border-color:var(--cc);box-shadow:var(--s2),0 0 0 4px var(--ccSuave)}
#q::placeholder{color:var(--tinta3);font-weight:400}
#q::-webkit-search-cancel-button{display:none}
.tecla{position:absolute;right:16px;font-size:11px;font-weight:600;color:var(--tinta3);
  border:1px solid var(--linea2);border-radius:6px;padding:2px 8px;background:var(--sup2);pointer-events:none}
.borrar{position:absolute;right:13px;border:0;background:transparent;color:var(--tinta3);
  font-size:23px;line-height:1;cursor:pointer;padding:5px 8px;border-radius:8px}
.borrar:hover{color:var(--tinta);background:var(--sup2)}

.barra{display:flex;gap:7px;padding:13px 0 12px;overflow-x:auto;scrollbar-width:none;align-items:center}
.barra::-webkit-scrollbar{display:none}
.f{flex:0 0 auto;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer;white-space:nowrap;
  padding:6px 13px;border-radius:999px;background:var(--sup);color:var(--tinta2);
  border:1px solid var(--linea2);transition:.16s}
.f .n{color:var(--tinta3);margin-left:6px;font-weight:500;font-variant-numeric:tabular-nums}
.f:hover{color:var(--tinta);border-color:var(--tinta3);transform:translateY(-1px)}
.f:focus-visible{outline:2px solid var(--cc);outline-offset:1px}
.f[aria-pressed="true"]{background:var(--cc);border-color:var(--cc);color:#fff;box-shadow:var(--s1)}
.f[aria-pressed="true"] .n{color:rgba(255,255,255,.78)}
.f.cat{padding-left:9px;display:inline-flex;align-items:center;gap:7px}
.f.cat .pt{width:8px;height:8px;border-radius:50%;background:var(--cc);flex:0 0 auto}
.f.cat[aria-pressed="true"] .pt{background:#fff}
.div{flex:0 0 auto;width:1px;height:22px;background:var(--linea2);margin:0 5px}

/* ════════ meta y grupos ════════ */
.meta{display:flex;justify-content:space-between;align-items:baseline;gap:18px;padding:22px 0 6px;flex-wrap:wrap}
.meta .izq{font-size:13.5px;color:var(--tinta2);font-weight:500}
.meta .izq b{color:var(--tinta);font-weight:700;font-variant-numeric:tabular-nums}
.meta .der{font-size:12px;color:var(--tinta3);font-weight:500}
ol,ul{list-style:none;margin:0;padding:0 0 80px}
.grupo{display:flex;align-items:center;gap:10px;padding:26px 0 10px}
.grupo .ico{width:26px;height:26px;border-radius:9px;background:var(--ccSuave);display:grid;place-items:center;flex:0 0 auto}
.grupo .ico svg{width:14px;height:14px;stroke:var(--cc);fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}
.grupo span{font-size:12px;font-weight:800;letter-spacing:.08em;color:var(--cc)}
.grupo::after{content:"";flex:1;height:1px;background:var(--linea)}

/* ════════ tarjeta ════════ */
.caso{position:relative;background:var(--sup);border:1px solid var(--linea);border-radius:var(--r);
  padding:15px 17px 15px 19px;margin-bottom:10px;box-shadow:var(--s1);
  display:grid;grid-template-columns:1fr auto;gap:4px 16px;align-items:start;
  scroll-margin:150px;transition:box-shadow .18s,transform .18s,border-color .18s;
  animation:sube .3s cubic-bezier(.22,.8,.3,1) backwards}
@keyframes sube{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
.caso::before{content:"";position:absolute;left:0;top:14px;bottom:14px;width:3px;
