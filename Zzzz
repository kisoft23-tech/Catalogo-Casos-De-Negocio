async function copiarTxt(txt){
  try{await navigator.clipboard.writeText(txt);}
  catch(e){const ta=document.createElement("textarea");ta.value=txt;document.body.append(ta);
    ta.select();try{document.execCommand("copy");}catch(e2){}ta.remove();}
}
function pinta(txt,t){
  const f=document.createDocumentFragment();
  if(!t||!t.length){f.append(txt);return f;}
  const n=norm(txt),m=new Array(txt.length).fill(false);
  t.forEach(x=>{let i=n.indexOf(x);while(i>-1){for(let k=i;k<i+x.length;k++)m[k]=true;i=n.indexOf(x,i+1);}});
  let i=0;
  while(i<txt.length){const on=m[i];let j=i;while(j<txt.length&&m[j]===on)j++;
    const s=txt.slice(i,j);
    if(on){const e=document.createElement("mark");e.textContent=s;f.append(e);}else f.append(s);i=j;}
  return f;
}

