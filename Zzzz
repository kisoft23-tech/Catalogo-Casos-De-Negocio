function filtrar(){
  const q=norm(document.getElementById("q").value).trim();
  const t=q?q.split(/\s+/).filter(Boolean):[];
  const vacio=r=>!r.k.length&&!r.p.length&&!r.g.length&&!(mias[r.id]||[]).length;
  let out=CASOS.filter(r=>{
    if(fCat&&r.c!==fCat)return false;
    if(fTipo&&r.t!==fTipo)return false;
    if(fFav&&!favs.has(r.id))return false;
    if(fFalta&&!vacio(r))return false;
    return t.every(x=>r._i.includes(x));});
  const punt=r=>{let s=0;
    t.forEach(x=>{
      if(norm(r.s).startsWith(x))s+=12;
      if(norm(r.s).includes(x))s+=8;
      if((mias[r.id]||[]).some(k=>norm(k).includes(x)))s+=7;
      if(r.p.some(k=>norm(k).includes(x)))s+=6;
      if(r.k.some(k=>norm(k).includes(x)))s+=5;
      if(r.g.some(k=>norm(k).includes(x)))s+=3;
      if(norm(r.m).includes(x))s+=3;
      if(norm(r.d).includes(x))s+=2;
      if(norm(r.o).includes(x))s+=1;});
    if(favs.has(r.id))s+=4; if(r.f)s+=3; if(r.u)s-=4; s+=Math.min(usos[r.id]||0,6); return s;};
  if(t.length)out.sort((a,b)=>punt(b)-punt(a));
  else out.sort((a,b)=>(favs.has(b.id)?1:0)-(favs.has(a.id)?1:0)||
    (usos[b.id]||0)-(usos[a.id]||0)||b.f-a.f||a.u-b.u||
    a.c.localeCompare(b.c)||a.m.localeCompare(b.m));
  return {out,t};
}

