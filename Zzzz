  if(vis.length){const b=document.createElement("b");b.textContent=vis.length;
    cuenta.append(b,vis.length===1?" nota":" notas");}
  ayudaTxt.textContent=notas.length?"Haz clic en el texto para editarlo":"";

  const bloque=(titulo,arr)=>{
    if(!arr.length)return;
    if(fij.length&&nor.length){const h=document.createElement("li");h.className="tituloFijas";
      h.textContent=titulo;cont.append(h);}
    const r=document.createElement("li"); r.className="rejilla";
    arr.forEach(n=>r.append(tarjetaNota(n,t)));
    cont.append(r);
  };
  bloque("Fijadas",fij); bloque("Otras",nor);

  if(!notas.length){
    nada.hidden=false;nada.textContent="";
    const c=document.createElement("div");c.className="cara";
    c.innerHTML='<svg viewBox="0 0 24 24"><path d="M5 3h9l5 5v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M14 3v5h5M8 13h8M8 17h5"/></svg>';
    nada.append(c);
    const p1=document.createElement("p");
    p1.append("Todavía no tienes notas. Úsalas para lo que quieras: pendientes del turno, pasos que siempre se te olvidan, números de folio.");
    const p2=document.createElement("p");
    p2.append("Se guardan solo en este navegador, así que nadie más del equipo las ve.");
    nada.append(p1,p2);
  }
}
function tarjetaNota(n,t){
  const d=document.createElement("article"); d.className="nota"; d.setAttribute("n",n.n||"d");
  if(n.f){const f=document.createElement("span");f.className="fij";f.textContent="★";
    f.title="Fijada";d.append(f);}

  const T=document.createElement("textarea"); T.className="ed t"; T.rows=1; T.value=n.t;
  T.placeholder="Título"; T.setAttribute("aria-label","Título de la nota");
  const C=document.createElement("textarea"); C.className="ed c"; C.value=n.c;
  C.placeholder="Escribe aquí…"; C.setAttribute("aria-label","Texto de la nota");
  const crecer=e=>{e.style.height="auto";e.style.height=e.scrollHeight+"px";};
  [T,C].forEach(e=>{e.oninput=()=>crecer(e); e.onkeydown=ev=>ev.stopPropagation();
    e.onblur=()=>{const nt=T.value.trim(),nc=C.value.trim();
      if(nt!==n.t||nc!==n.c){n.t=nt;n.c=nc;n.ts=Date.now();grabar();}};});
  setTimeout(()=>{crecer(T);crecer(C);},0);
  d.append(T,C);

  const m=document.createElement("div"); m.className="meta2";
  const ti=document.createElement("time"); ti.dateTime=new Date(n.ts).toISOString();
  ti.textContent=fecha(n.ts); m.append(ti);
  const bb=document.createElement("div"); bb.className="bb";

  const bc=document.createElement("button"); bc.type="button"; bc.textContent="◑";
  bc.title="Cambiar color"; bc.setAttribute("aria-label","Cambiar color");
  bc.onclick=()=>{
    if(d.querySelector(".pal")){d.querySelector(".pal").remove();return;}
    const p=paleta(n.n||"d",c=>{n.n=c;grabar();render();});
    p.style.marginTop="9px"; d.append(p);
  };
  const bk=document.createElement("button"); bk.type="button"; bk.textContent="⧉";
  bk.title="Copiar la nota"; bk.setAttribute("aria-label","Copiar la nota");
  bk.onclick=async()=>{await copiarTxt((n.t?n.t+"\n\n":"")+n.c);aviso("Nota copiada");};
  const bf=document.createElement("button"); bf.type="button"; bf.textContent=n.f?"★":"☆";
  bf.title=n.f?"Quitar de fijadas":"Fijar arriba"; bf.setAttribute("aria-label","Fijar nota");
  bf.onclick=()=>{n.f=n.f?0:1;grabar();render();};
  const bd=document.createElement("button"); bd.type="button"; bd.textContent="🗑";
  bd.title="Borrar nota"; bd.setAttribute("aria-label","Borrar nota");
  bd.onclick=()=>{
    const i=notas.indexOf(n); if(i<0)return;
    const copia={...n}; notas.splice(i,1); grabar(); render();
    aviso("Nota borrada");
    const a=document.getElementById("aviso");
    const u=document.createElement("button"); u.textContent=" Deshacer";
    u.style.cssText="background:none;border:0;color:inherit;font:inherit;text-decoration:underline;cursor:pointer;pointer-events:auto";
    u.onclick=()=>{notas.splice(i,0,copia);grabar();render();a.classList.remove("ver");};
    a.append(u); a.style.pointerEvents="auto";
    setTimeout(()=>{a.style.pointerEvents="none";},1900);
  };
  bb.append(bk,bc,bf,bd); m.append(bb); d.append(m);
  return d;
}
function verAyuda(){
  const qq=norm(q.value).trim(), t=qq?qq.split(/\s+/).filter(Boolean):[];
  const esCliente=x=>/cliente/i.test(x.q);
  barra.textContent="";
  barra.append(boton("Todos",AYUDA.length,!fAyuda,"",()=>{fAyuda=null;render();}));
  const dv=document.createElement("span");dv.className="div";barra.append(dv);
  barra.append(boton("Para el asesor",AYUDA.filter(x=>!esCliente(x)).length,fAyuda==="asesor","",
    ()=>{fAyuda=fAyuda==="asesor"?null:"asesor";render();}));
  barra.append(boton("Para mandar al cliente",AYUDA.filter(esCliente).length,fAyuda==="cliente","",
    ()=>{fAyuda=fAyuda==="cliente"?null:"cliente";render();}));

  const out=AYUDA.filter(x=>{
    if(fAyuda==="cliente"&&!esCliente(x))return false;
    if(fAyuda==="asesor"&&esCliente(x))return false;
    return t.every(w=>norm(x.n).includes(w));});

  if(out.length){const b=document.createElement("b");b.textContent=out.length;
    cuenta.append(b,out.length===1?" artículo":" artículos del Centro de ayuda");}
  ayudaTxt.textContent="Se abren en otra pestaña";

  const bloques=[["Para el asesor",out.filter(x=>!esCliente(x))],
                 ["Para mandar al cliente",out.filter(esCliente)]];
  bloques.forEach(([tit,arr])=>{
    if(!arr.length)return;
    if(!fAyuda){const h=document.createElement("li");h.className="grupo";
      const s2=document.createElement("span");s2.textContent=tit;h.append(s2);cont.append(h);}
    arr.forEach((x,i)=>{
      const li=document.createElement("li");
      const a=document.createElement("a");a.className="enl";a.href=x.u;a.target="_blank";a.rel="noopener";
      a.style.animation="sube .3s cubic-bezier(.22,.8,.3,1) backwards";
      a.style.animationDelay=Math.min(i,14)*20+"ms";
      const n=document.createElement("span");n.className="n";n.append(pinta(x.n,t));
      const ic=document.createElement("span");ic.className="q";ic.textContent="Abrir";
      a.append(n,ic);li.append(a);cont.append(li);});});

  if(!out.length){nada.hidden=false;nada.textContent="";
    const p=document.createElement("p");p.append("Ningún artículo coincide con esa búsqueda.");
    nada.append(p);}
}
function verCasos(){
  pintarBarra();
  const {out,t}=filtrar();
  lista=out;sel=-1;
  document.getElementById("borrar").hidden=!document.getElementById("q").value;
  document.getElementById("tecla").hidden=!!document.getElementById("q").value;
  if(out.length){
    const b=document.createElement("b");b.textContent=out.length;
    cuenta.append(b,out.length===1?" caso":" casos");
    if(fCat)cuenta.append(" en "+fCat);
  }
  ayudaTxt.textContent=out.length>1?"↑ ↓ para moverte · Enter para copiar":"";
  const agrupar=!t.length&&!fCat;let ult=null;
  out.slice(0,250).forEach((r,i)=>{
    if(agrupar&&r.c!==ult){ult=r.c;
      const h=document.createElement("li");h.className="grupo";h.dataset.cat=r.c;
      h.append(icono(r.c,"ico"));
      const s=document.createElement("span");s.textContent=r.c;h.append(s);cont.append(h);}
    const el=tarjeta(r,i,t); el.style.animationDelay=Math.min(i,14)*22+"ms"; cont.append(el);});
  if(!out.length){
    nada.hidden=false;nada.textContent="";
    const c=document.createElement("div");c.className="cara";
    c.innerHTML='<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/><path d="M8.5 11h5"/></svg>';
    nada.append(c);
    const p=document.createElement("p");
    if(fFalta)p.append("No quedan casos sin descripción con estos filtros.");
    else if(fFav)p.append("Todavía no marcas ningún caso como frecuente. La estrella los guarda aquí.");
    else p.append("Nada coincide con esa búsqueda.");
    const p2=document.createElement("p");
    p2.append("Si el catálogo no tiene la opción exacta, se usa la más parecida y el inciso se da como correcto.");
    nada.append(p,p2);}
}
function tarjeta(r,idx,t){
  const li=document.createElement("li");
  li.className="caso";li.dataset.cat=r.c;li.dataset.i=idx;
  const izq=document.createElement("div");
  const via=document.createElement("div");via.className="via";
  via.append(icono(r.c,"ico"));
  const cb=document.createElement("b");cb.append(pinta(r.c,t));
  via.append(cb," / ",pinta(r.m,t));izq.append(via);
  const tit=document.createElement("div");tit.className="tit";tit.append(pinta(r.s,t));
  if(r.f){const e=document.createElement("span");e.className="pin";e.title="De los que más se usan";tit.append(e);}
  if((usos[r.id]||0)>=3){const e=document.createElement("span");e.className="usado";
    e.textContent="×"+usos[r.id];e.title="Veces que lo has copiado";tit.append(e);}
  izq.append(tit);
  const h=document.createElement("div");h.className="hace";h.append("Solución: ");
  const hb=document.createElement("b");hb.append(pinta(r.o,t));h.append(hb);izq.append(h);
  if(r.d){const d=document.createElement("div");d.className="dice";d.append(pinta(r.d,t));izq.append(d);}
  const todas=[...(mias[r.id]||[]).map(x=>[x,"mia"]),...r.p.map(x=>[x,"mia"]),
               ...r.k.map(x=>[x,""]),...r.g.map(x=>[x,"sug"])];
  if(todas.length){
    const c=document.createElement("div");c.className="claves";
    todas.slice(0,18).forEach(([x,cl])=>{const e=document.createElement("span");
      e.className="k"+(cl?" "+cl:"");e.append(pinta(x,t));c.append(e);});
    izq.append(c);}
  if(r.a.length){
    const g=document.createElement("div");g.className="gest";
    r.a.forEach(a=>{const f=document.createElement("div");
      const ar=document.createElement("span");ar.className="ar";ar.textContent=a[0];f.append(ar);
      if(a[1])f.append(" · "+a[1]);
      if(a[2]){const du=document.createElement("span");du.className="du";du.textContent=" · "+a[2];f.append(du);}
      g.append(f);});
    izq.append(g);}
  li.append(izq);
  const acc=document.createElement("div");acc.className="acc";
  if(!todas.length){const e=document.createElement("span");e.className="et falta";e.textContent="FALTA DESCRIPCIÓN";acc.append(e);}
  if(r.u){const e=document.createElement("span");e.className="et";e.textContent="POCO USADO";acc.append(e);}
  if(r.t==="Administrativo"){const e=document.createElement("span");e.className="et adm";e.textContent="ADMIN";acc.append(e);}
  const bMas=document.createElement("button");bMas.className="b";bMas.textContent="+";
  bMas.title="Añadir palabras de búsqueda";bMas.setAttribute("aria-label","Añadir palabras de búsqueda");
  bMas.onclick=()=>abrirEdit(li,r);acc.append(bMas);
  const bCop=document.createElement("button");bCop.className="b";bCop.textContent="Copiar";
  bCop.title="Copiar la tipificación completa";
  bCop.onclick=async()=>{await copiarTxt(r.ruta);aviso("Copiado: "+r.s);
    usos[r.id]=(usos[r.id]||0)+1; grabar();
    bCop.classList.add("ok");setTimeout(()=>bCop.classList.remove("ok"),900);};
  acc.append(bCop);
  const bFav=document.createElement("button");bFav.className="b"+(favs.has(r.id)?" on":"");
  bFav.textContent=favs.has(r.id)?"★":"☆";bFav.title="Guardar como frecuente";
  bFav.setAttribute("aria-label","Guardar como frecuente");
  bFav.onclick=()=>{favs.has(r.id)?favs.delete(r.id):favs.add(r.id);grabar();render();};
  acc.append(bFav);li.append(acc);return li;
}
function abrirEdit(li,r){
  if(li.querySelector(".edit"))return;
  const box=document.createElement("div");box.className="edit";
  const inp=document.createElement("input");
  inp.placeholder="Palabras separadas por coma: no se ve, pantalla negra";
  inp.value=(mias[r.id]||[]).join(", ");
  const ok=document.createElement("button");ok.className="b";ok.textContent="Guardar";
  const g=()=>{const v=inp.value.split(",").map(x=>x.trim()).filter(Boolean);
    if(v.length)mias[r.id]=v;else delete mias[r.id];
    grabar();indexar(r);render();aviso(v.length?"Palabras guardadas":"Palabras borradas");};
  ok.onclick=g;
  inp.onkeydown=e=>{e.stopPropagation();
    if(e.key==="Enter"){e.preventDefault();g();}if(e.key==="Escape")box.remove();};
  box.append(inp,ok);li.firstChild.append(box);inp.focus();
}
function mover(d){
  if(vista!=="casos"||!lista.length)return;
  const n=Math.min(lista.length,250);sel=(sel+d+n)%n;
  cont.querySelectorAll(".caso").forEach(e=>e.classList.remove("sel"));
  const el=cont.querySelector('.caso[data-i="'+sel+'"]');
  if(el){el.classList.add("sel");el.scrollIntoView({block:"nearest"});}
}
const q=document.getElementById("q");
document.addEventListener("keydown",e=>{
  if(document.activeElement.tagName==="INPUT"&&document.activeElement!==q)return;
  if(e.key==="/"&&document.activeElement!==q){e.preventDefault();vista="casos";render();q.focus();q.select();return;}
  if(e.key==="ArrowDown"){e.preventDefault();mover(1);}
  if(e.key==="ArrowUp"){e.preventDefault();mover(-1);}
  if(e.key==="Enter"&&sel>-1&&lista[sel]){e.preventDefault();
    copiarTxt(lista[sel].ruta);aviso("Copiado: "+lista[sel].s);
    usos[lista[sel].id]=(usos[lista[sel].id]||0)+1; grabar();}
  if(e.key==="Escape"){q.value="";render();q.focus();}
});
